<mxfile host="app.diagrams.net" modified="2026-06-06T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="architecture" name="总体架构">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="昇腾长文本推理优化总体架构" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="370" y="24" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="a-subtitle" value="围绕 PD 分离隔离阶段干扰，并用 PCP/DCP 与动态 CP 缓解长上下文带来的计算、显存和 HBM 访存瓶颈" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="170" y="62" width="940" height="30" as="geometry"/></mxCell>
        <mxCell id="a-req" value="长上下文&lt;br&gt;请求流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="34" y="276" width="110" height="70" as="geometry"/></mxCell>
        <mxCell id="a-sched" value="入口调度&lt;br&gt;P/D 路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C2410C;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="276" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="a-pool" value="&lt;b&gt;Prefill 资源池&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;计算密集：长 prompt 编码、KV 生成、TTFT&lt;/font&gt;&lt;br&gt;&lt;br&gt;PCP 序列切分　高 TP/PP 批量计算&lt;br&gt;&lt;br&gt;目标：降低 TTFT，充分利用 AI Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FF;strokeColor=#2F5597;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="285" height="230" as="geometry"/></mxCell>
        <mxCell id="a-kv" value="&lt;b&gt;KV Connector&lt;/b&gt;&lt;br&gt;&lt;br&gt;rank/layer 映射&lt;br&gt;KV 传输&lt;br&gt;layout 转换&lt;br&gt;PageAttention 写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D8;strokeColor=#B7791F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="205" width="185" height="200" as="geometry"/></mxCell>
        <mxCell id="a-dpool" value="&lt;b&gt;Decode 资源池&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;访存密集：KV 读取、逐 token 生成、TPOT/ITL&lt;/font&gt;&lt;br&gt;&lt;br&gt;DCP KV 分片　动态 CP 跨 DP 协同&lt;br&gt;&lt;br&gt;目标：降低 HBM 压力与尾部 ITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2F7D32;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="a-out" value="输出&lt;br&gt;token 流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1138" y="490" width="110" height="70" as="geometry"/></mxCell>
        <mxCell id="a-prof" value="Profiling：HBM 读写、AI Core 利用率、KV 传输时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#6D28D9;fontSize=16;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="420" height="45" as="geometry"/></mxCell>
        <mxCell id="a-flow" value="长上下文输入 → Prefill 计算放大 → KV 传输/重排 → Decode HBM 访存 → TTFT/TPOT/ITL 优化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="235" y="590" width="810" height="50" as="geometry"/></mxCell>
        <mxCell id="a-e1" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F5597;fontColor=#64748B;" edge="1" parent="1" source="a-req" target="a-sched"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="Prefill batch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F5597;fontColor=#64748B;" edge="1" parent="1" source="a-sched" target="a-pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="KV Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B7791F;fontColor=#64748B;" edge="1" parent="1" source="a-pool" target="a-kv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" value="本地 KV blocks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B7791F;fontColor=#64748B;" edge="1" parent="1" source="a-kv" target="a-dpool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e5" value="Decode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F7D32;fontColor=#64748B;" edge="1" parent="1" source="a-dpool" target="a-out"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kv-layout" name="KV布局映射">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="k-title" value="PD 分离中的 KV Cache 布局映射与转换" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="300" y="25" width="680" height="40" as="geometry"/></mxCell>
        <mxCell id="k-subtitle" value="P/D 两侧 TP、PP 与注意力结构可能不同，Connector 需要把源端 KV 精确转换成 Decode 侧 PageAttention 可消费的 block 布局" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="130" y="65" width="1020" height="30" as="geometry"/></mxCell>
        <mxCell id="k-p" value="&lt;b&gt;Prefill 侧 KV 生产&lt;/b&gt;&lt;br&gt;示例：P TP=4，PP=2&lt;br&gt;&lt;br&gt;PP stage 0：P0 → h0, B0..n&lt;br&gt;PP stage 0：P1 → h1, B0..n&lt;br&gt;PP stage 1：P2 → h2, B0..n&lt;br&gt;PP stage 1：P3 → h3, B0..n&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;GQA/MHA/MQA：KV head 随 TP rank 切分&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FF;strokeColor=#2F5597;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="310" height="360" as="geometry"/></mxCell>
        <mxCell id="k-c" value="&lt;b&gt;KV Connector&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 感知 TP/PP/layer partition&lt;br&gt;2. 选择 P rank 或 rank 集合&lt;br&gt;3. HCCL/HCCS/RDMA 传输&lt;br&gt;4. split / cat / transpose by block&lt;br&gt;5. _npu_page_load + reshape_and_cache&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;目标：减少逐层逐 block 的 copy/reshape 与 kernel launch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D8;strokeColor=#B7791F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="505" y="150" width="300" height="360" as="geometry"/></mxCell>
        <mxCell id="k-d" value="&lt;b&gt;Decode 侧 KV 消费&lt;/b&gt;&lt;br&gt;PageAttention block table / slot mapping&lt;br&gt;&lt;br&gt;D rank 0：h0 h1 / B0 B1 B2&lt;br&gt;D rank 1：h2 h3 / B3 B4 B5&lt;br&gt;&lt;br&gt;本地 KV block 写入&lt;br&gt;Decode forward 读取分片 KV&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2F7D32&quot;&gt;保证输出一致性，并在 D 写入完成后释放 P 侧缓存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2F7D32;fontSize=15;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="310" height="360" as="geometry"/></mxCell>
        <mxCell id="k-note1" value="MLA：可在等价 P rank 中负载均衡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C2410C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="155" y="565" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="k-note2" value="GQA/MHA/MQA：必须按 KV head 和 layer 精确匹配，避免 head 缺失或 block 无法消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C2410C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="520" y="565" width="590" height="48" as="geometry"/></mxCell>
        <mxCell id="k-e1" value="源端 KV layout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B7791F;fontColor=#64748B;" edge="1" parent="1" source="k-p" target="k-c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k-e2" value="目标端 block layout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B7791F;fontColor=#64748B;" edge="1" parent="1" source="k-c" target="k-d"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dynamic-cp" name="动态CP调度">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d-title" value="Decode 节点动态 CP 与跨 DP 调度" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="380" y="25" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="d-subtitle" value="短请求保持 CP=1 的低开销路径，超长请求按需跨多个 DP-attention 副本协同处理，缓解 Decode 阶段 KV 访存 straggler" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="110" y="65" width="1060" height="30" as="geometry"/></mxCell>
        <mxCell id="d-traffic" value="&lt;b&gt;在线请求流&lt;/b&gt;&lt;br&gt;&lt;br&gt;短请求 4K--32K&lt;br&gt;短请求 4K--32K&lt;br&gt;短请求 4K--32K&lt;br&gt;短请求 4K--32K&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;长请求 256K--1M&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;混部流量导致 DP 副本负载倾斜&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="210" height="360" as="geometry"/></mxCell>
        <mxCell id="d-sched" value="&lt;b&gt;CrossDPScheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;上下文长度&lt;br&gt;KV Pool 压力&lt;br&gt;并发与队列深度&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;选择 CP 粒度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#6D28D9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="205" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="d-short" value="&lt;b&gt;短请求路径&lt;/b&gt;&lt;br&gt;CP=1&lt;br&gt;&lt;br&gt;DP0：本地 KV&lt;br&gt;DP1：本地 KV&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2F7D32&quot;&gt;低通信开销，保持常规 DP-attention&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2F7D32;fontSize=15;" vertex="1" parent="1"><mxGeometry x="660" y="155" width="235" height="300" as="geometry"/></mxCell>
        <mxCell id="d-long" value="&lt;b&gt;长请求路径&lt;/b&gt;&lt;br&gt;CP&gt;1&lt;br&gt;&lt;br&gt;DP2 / DP3 / DP4 / DP5 协同&lt;br&gt;CrossDPKVCacheManager&lt;br&gt;score/LSE 聚合&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#0F766E&quot;&gt;跨 DP 分摊 KV 访存压力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF7F3;strokeColor=#0F766E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="155" width="260" height="300" as="geometry"/></mxCell>
        <mxCell id="d-out" value="稳定 Decode&lt;br&gt;token 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="d-note1" value="静态 CP：短请求多付通信开销，或长请求集中成 straggler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C2410C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="565" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="d-note2" value="动态 CP：用跨 DP 通信换取 HBM 访存分摊；1M、16 rps 前期实验 P90 ITL 约 60 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF7F3;strokeColor=#0F766E;fontSize=15;" vertex="1" parent="1"><mxGeometry x="720" y="565" width="470" height="55" as="geometry"/></mxCell>
        <mxCell id="d-e1" value="请求元数据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1F2937;fontColor=#64748B;" edge="1" parent="1" source="d-traffic" target="d-sched"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-e2" value="短请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F7D32;fontColor=#64748B;" edge="1" parent="1" source="d-sched" target="d-short"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-e3" value="长请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C2410C;fontColor=#64748B;" edge="1" parent="1" source="d-sched" target="d-long"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F7D32;" edge="1" parent="1" source="d-short" target="d-out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F7D32;" edge="1" parent="1" source="d-long" target="d-out"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="roadmap" name="研究路线">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r-title" value="研究路线与实验闭环" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="460" y="25" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="r-subtitle" value="按“性能剖析、PD/KV 适配、Decode 动态 CP、运行时弹性与 KV 去冗余”逐步推进，并用端到端指标反向校准设计" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="120" y="65" width="1040" height="30" as="geometry"/></mxCell>
        <mxCell id="r-input" value="&lt;b&gt;实验输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;模型：Qwen / DeepSeek&lt;br&gt;平台：昇腾 910 系列&lt;br&gt;上下文：4K--1M&lt;br&gt;负载：1--16 rps&lt;br&gt;对照：混合部署 / 静态 CP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="35" y="185" width="210" height="270" as="geometry"/></mxCell>
        <mxCell id="r-s1" value="&lt;b&gt;1 性能剖析&lt;/b&gt;&lt;br&gt;TTFT/TPOT/ITL&lt;br&gt;HBM 与 AI Core&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;2026.06--08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FF;strokeColor=#2F5597;fontSize=15;" vertex="1" parent="1"><mxGeometry x="285" y="185" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="r-s2" value="&lt;b&gt;2 PD/KV 适配&lt;/b&gt;&lt;br&gt;TP/PP 映射&lt;br&gt;KV layout 转换&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;2026.09--11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D8;strokeColor=#B7791F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="185" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="r-s3" value="&lt;b&gt;3 动态 CP&lt;/b&gt;&lt;br&gt;Domain 调度&lt;br&gt;跨 DP attention&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;2026.12--2027.01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#2F7D32;fontSize=15;" vertex="1" parent="1"><mxGeometry x="715" y="185" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="r-s4" value="&lt;b&gt;4 弹性与去冗余&lt;/b&gt;&lt;br&gt;DP 扩缩容&lt;br&gt;TP 域 DCP&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;2027.02--03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#6D28D9;fontSize=15;" vertex="1" parent="1"><mxGeometry x="930" y="185" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="r-eval" value="&lt;b&gt;统一评估&lt;/b&gt;&lt;br&gt;延迟：TTFT / TPOT / ITL P90/P99&lt;br&gt;资源：显存峰值 / HBM 读写 / 带宽利用率&lt;br&gt;系统：QPS / 负载均衡 / 输出一致性&lt;br&gt;补充：KV 传输时间、layout 转换时间、消融与回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="285" y="405" width="825" height="115" as="geometry"/></mxCell>
        <mxCell id="r-out" value="&lt;b&gt;预期产出&lt;/b&gt;&lt;br&gt;&lt;br&gt;昇腾 PD 分离 KV 传输与转换方法&lt;br&gt;Decode 动态 CP 调度原型与实验&lt;br&gt;DP 动态扩缩容 / TP 域 KV 去冗余&lt;br&gt;论文图表、消融分析、答辩材料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C2410C;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1138" y="185" width="115" height="335" as="geometry"/></mxCell>
        <mxCell id="r-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F5597;" edge="1" parent="1" source="r-input" target="r-s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F5597;" edge="1" parent="1" source="r-s1" target="r-s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B7791F;" edge="1" parent="1" source="r-s2" target="r-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2F7D32;" edge="1" parent="1" source="r-s3" target="r-s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#C2410C;" edge="1" parent="1" source="r-s4" target="r-out"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
